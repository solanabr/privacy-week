# Copy to .env.local for local development (`cp .env.example .env.local`).
# Everything here is server-side. There is intentionally no NEXT_PUBLIC_ variable:
# the browser never talks to Supabase.

# --- Database (local Supabase, from `supabase status`) ---
# Server-only. Use the service role key; it bypasses RLS and must never reach the client.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# --- Site ---
# Local: http://localhost:3000. Production: https://privacy.superteam.com.br
SITE_URL=http://localhost:3000

# --- X OAuth 2.0 (Web App / confidential client) ---
# Register the exact callback `${SITE_URL}/auth/x/callback` in the X Developer Console.
# The client secret stays on the server and also signs the short-lived connection cookie.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Submission window (ISO 8601 with offset, America/Sao_Paulo) ---
SUBMISSIONS_OPEN_AT=2026-09-30T15:00:00-03:00
SUBMISSIONS_CLOSE_AT=2026-10-03T23:59:59-03:00

# --- Admin (HTTP Basic Auth for /admin) ---
# Comma-separated name:password pairs, one per judge. The name is stored as the judge.
ADMIN_USERS=admin:change-me
# Optional: which admin names count as judges on the dashboard (defaults to all).
# JUDGES=Victor,Marcelo,Matheus

# --- Abuse protection ---
# Salt for hashing submitter IPs (SHA-256). Use a long random string.
IP_HASH_SALT=change-me-to-a-long-random-string

# --- Results (P2) ---
# "true" reveals the results section and /resultados.
RESULTS_PUBLISHED=false

# --- Development only ---
# Override "now" to test the submission window. Ignored in production builds.
# DEV_NOW=2026-10-01T12:00:00-03:00
